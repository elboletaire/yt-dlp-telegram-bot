# Telegram API Configuration
API_ID=12345
API_HASH=your_api_hash_here
BOT_TOKEN=123456:ABC-DEF1234567890

# User/Group Permissions
ALLOWED_USERIDS=123456,789012,999999
ADMIN_USERIDS=123456
ALLOWED_GROUPIDS=-2173781256,-1234567890

# Trolling Configuration
TROLL_USERIDS=789012,999999
TROLL_SENTENCES=Nice try, buddy!::Not today, my friend!::Gotcha, haha!::Maybe next time, pal!::🤡 You thought that would work?::Come on, really?::Try again later!
TROLL_PROBABILITY=30

# Optional Settings
MAX_SIZE=500MB
YTDLP_PATH=yt-dlp

# Optional: yt-dlp cookies (if needed for certain sites)
# YTDLP_COOKIES=your_cookies_here

# Likes and best-of (optional)
# LIKES_ENABLED=true
# DB_PATH=/data/bot.db
# BEST_OF_INTERVAL=week   # day, week, month or off
# BEST_OF_AT=sun 20:00    # HH:MM (day), <mon..sun> HH:MM (week), <1-28> HH:MM (month); uses TZ
# BEST_OF_COUNT=3

# Optional: override bot messages (see messages.default.yaml for keys)
# MESSAGES_FILE=/data/messages.yaml
